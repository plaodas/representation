{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "customConditions": [
      "react-native"
    ],
    "types": [
      "react"
    ]
  },
  "include": [
    "app",
    "components",
    "data",
    "domain",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "domain/**/*.test.ts"
  ],
  "extends": "expo/tsconfig.base"
}
